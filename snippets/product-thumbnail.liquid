{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{% comment %}
  Renders a product thumbnail with a modal-opener

  Accepts:
  - media: {Object} Product Media object
  - media_count: {Number} Number of media objects
  - position: {String} Position of the media. Used for accessible label.
  - desktop_layout: {String} Layout of the media for desktop.
  - mobile_layout: {String} Layout of the media for mobile.
  - loop: {Boolean} Enable video looping (optional)
  - modal_id: {String} The product modal that will be shown by clicking the thumbnail
  - xr_button: {Boolean} Renders the "View in your space" button (shopify-xr-button) if the media is a 3D Model
  - media_width: {Float} The width percentage that the media column occupies on desktop.

  Usage:
  {% render 'product-thumbnail',
    media: media,
    position: forloop.index,
    loop: section.settings.enable_video_looping,
    modal_id: section.id
  %}
{% endcomment %}
{%- liquid
  assign desktop_columns = 1
  if desktop_layout == 'columns' and media_count > 1
    assign desktop_columns = 2
  endif

  assign fetchpriority = 'low'
  assign image_loading = 'lazy'

  if position == 0
    assign fetchpriority = 'high'
    assign image_loading = 'eager'
  endif

  assign media_alt = media.preview_image.alt | escape
-%}
{%- capture sizes -%}
{%- if desktop_columns > 1 -%}
(max-width: 768px) calc(100vw - 3rem), calc(((min({{ 1410 | plus: 30 }}px, 100vw) * {{ media_width }}) - 4.5rem - {{ desktop_columns | times: 1 | minus: 1 }}rem) / {{ desktop_columns }})
{%- else -%}
(max-width: 768px) calc(100vw - 3rem), calc(((min({{ 1410 | plus: 30 }}px, 100vw) * {{ media_width }}) - 4.5rem) / {{ desktop_columns }})
{%- endif -%}
{%- endcapture -%}
<div
  role="listitem"
  tabindex="-1"
  class="product__media-item swiper-slide"
  data-media-id="{{ media.id }}"
  data-media-type="{{ media.media_type }}"
  data-media-index="{{ position }}"
  data-src="{{ media.preview_image | image_url: width: 1946 }}"
  data-alt="{{ media.preview_image.alt | escape }}"
  data-pswp-width="{{ media.preview_image.width }}"
  data-pswp-height="{{ media.preview_image.width | divided_by: media.preview_image.aspect_ratio | ceil }}"
>
  <div
    class="product__media-container blocks-radius media-type-{{ media.media_type }}"
    style="--aspect-ratio: {{ media.aspect_ratio | default: 1.0 }};"
  >
    {%- case media.media_type -%}
      {%- when 'model' -%}
        <product-model class="deferred-media no-js-hidden" data-media-id="{{ media.id }}">
          <button id="Deferred-Poster-{{ media.id }}" class="deferred-media__poster media-wrapper" type="button">
            {{
              media.preview_image
              | image_url: width: 1946
              | image_tag:
                alt: media_alt,
                is: 'image-lazy',
                loading: image_loading,
                fetchpriority: fetchpriority,
                sizes: sizes,
                widths: '400, 620, 690, 810, 980, 1240, 1380, 1620, 1960'
            }}
            <span class="deferred-media__poster-button motion-reduce">
              <span class="visually-hidden">{{ 'products.product.media.play_model' | t }}</span>
              {%- render 'icon-3d-model' -%}
            </span>
          </button>
          <template>
            {{- media | media_tag: image_size: '2048x', toggleable: true -}}
          </template>
        </product-model>
        {%- if xr_button -%}
          <button
            class="product__xr-button btn btn--primary absolute z-1 bottom-0 left-0 right-0"
            type="button"
            aria-label="{{ 'products.product.xr_button_label' | t }}"
            data-shopify-xr
            data-shopify-model3d-id="{{ media.id }}"
            data-shopify-title="{{ product.title | escape }}"
            data-shopify-xr-hidden
          >
            {{ 'products.product.xr_button' | t }}
          </button>
        {%- endif -%}
      {%- when 'video' -%}
        {%- liquid
          assign replacement_video_url = nil
          if media.id == 46646754508915
            assign replacement_video_url = 'fanny-signature-utility.mp4' | asset_url
          elsif media.id == 46647341351027
            assign replacement_video_url = 'fanny-navy-gallery.mp4' | asset_url | replace: '//cdn.shopify.com/', '/cdn/'
          elsif media.id == 46647338434675
            assign replacement_video_url = 'fanny-burgundy-gallery.mp4' | asset_url | replace: '//cdn.shopify.com/', '/cdn/'
          endif
        -%}
        {%- render 'video',
          video: media,
          replacement_video_url: replacement_video_url,
          muted: true,
          autoplay: true,
          controls: true,
          loop: loop,
          show_play_button: true
        -%}
      {%- when 'external_video' -%}
        {%- render 'video',
          video_url: media,
          video_url_type: media.host,
          video_url_id: media.external_id,
          cover_image: media.preview_image,
          muted: true,
          autoplay: true,
          controls: true,
          loop: loop,
          show_play_button: true
        -%}
      {%- else -%}
        {%- if position == 0 -%}
          <div class="product__media media-wrapper">
        {%- else -%}
          <motion-element data-motion="zoom-out-sm" class="product__media media-wrapper">
        {%- endif -%}
          <img
            src="{{ media.preview_image | image_url: width: 1946 }}"
            srcset="{{ media.preview_image | image_url: width: 400 }} 400w, {{ media.preview_image | image_url: width: 620 }} 620w, {{ media.preview_image | image_url: width: 810 }} 810w, {{ media.preview_image | image_url: width: 980 }} 980w, {{ media.preview_image | image_url: width: 1240 }} 1240w, {{ media.preview_image | image_url: width: 1380 }} 1380w, {{ media.preview_image | image_url: width: 1620 }} 1620w, {{ media.preview_image | image_url: width: 1946 }} 1946w"
            sizes="{{ sizes | strip }}"
            width="{{ media.preview_image.width }}"
            height="{{ media.preview_image.height }}"
            alt="{{ media_alt }}"
            loading="{{ image_loading }}"
            fetchpriority="{{ fetchpriority }}"
            decoding="async"
          >
        {%- if position == 0 -%}
          </div>
        {%- else -%}
          </motion-element>
        {%- endif -%}
        {%- if enable_image_zoom -%}
          <span
            class="product__media-icon"
            aria-hidden="true"
          >
            {%- render 'icon-zoom' -%}
          </span>
          <button
            class="product__media-zoom btn--inherit js-photoswipe--zoom"
            type="button"
            aria-haspopup="dialog"
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            data-media-index="{{ position }}"
          >
            <span class="visually-hidden">
              {{ 'products.product.media.open_media' | t: index: position }}
            </span>
          </button>
        {%- endif -%}
    {%- endcase -%}
  </div>
</div>
