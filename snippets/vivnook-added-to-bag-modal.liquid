<div class="vivnook-added-to-bag" id="VivnookAddedToBag" hidden aria-hidden="true">
  <div class="vivnook-added-to-bag__backdrop" data-added-bag-close></div>
  <section class="vivnook-added-to-bag__panel" role="dialog" aria-modal="true" aria-labelledby="VivnookAddedToBagTitle">
    <button class="vivnook-added-to-bag__close" type="button" data-added-bag-close aria-label="Close">&times;</button>
    <h2 id="VivnookAddedToBagTitle">Added to Bag <span aria-hidden="true">&#10003;</span></h2>
    <div class="vivnook-added-to-bag__item" data-added-bag-item></div>
    <button class="vivnook-added-to-bag__view" type="button" data-added-bag-view>View Bag (<span data-added-bag-count>0</span>)</button>
    <section class="vivnook-added-to-bag__recommendations" data-added-bag-recommendations hidden>
      <h3>You May Also Like</h3>
      <div class="vivnook-added-to-bag__recommendation-carousel">
        <button class="vivnook-added-to-bag__recommendation-nav vivnook-added-to-bag__recommendation-nav--previous" type="button" data-recommendation-previous aria-label="Previous recommendation">&lsaquo;</button>
        <div class="vivnook-added-to-bag__recommendation-list" data-added-bag-recommendation-list></div>
        <button class="vivnook-added-to-bag__recommendation-nav vivnook-added-to-bag__recommendation-nav--next" type="button" data-recommendation-next aria-label="Next recommendation">&rsaquo;</button>
      </div>
    </section>
  </section>
</div>
