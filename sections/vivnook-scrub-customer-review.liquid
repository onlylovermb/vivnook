{{ 'section-vivnook-scrub-customer-review.css' | asset_url | stylesheet_tag }}
<section class="vivnook-customer-review" data-customer-review aria-label="{{ section.settings.aria_label | escape }}">
  <div class="vivnook-customer-review__header">
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="vivnook-customer-review__controls">
      <button type="button" data-review-step="-1" aria-label="Previous reviews">&lsaquo;</button>
      <button type="button" data-review-step="1" aria-label="Next reviews">&rsaquo;</button>
    </div>
  </div>
  <div class="vivnook-customer-review__viewport">
    <div class="vivnook-customer-review__track">
      {% for block in section.blocks %}
        <a class="vivnook-customer-review__card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320, 600, 900, 1200', sizes: '(min-width: 750px) 23vw, 80vw' }}{% endif %}
          {% if block.settings.caption != blank %}<span>{{ block.settings.caption | escape }}</span>{% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>
<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    if (!section || section.dataset.ready) return;
    section.dataset.ready = 'true';
    const track = section.querySelector('.vivnook-customer-review__track');
    const cards = [...section.querySelectorAll('.vivnook-customer-review__card')];
    let index = 0;
    const visible = () => window.matchMedia('(max-width: 749px)').matches ? 2 : 4;
    function move(step) { index = Math.max(0, Math.min(Math.max(0, cards.length - visible()), index + step)); track.style.transform = `translateX(calc(${index} * (var(--review-card-width) + var(--review-gap)) * -1))`; }
    section.addEventListener('click', event => { const button = event.target.closest('[data-review-step]'); if (button) move(Number(button.dataset.reviewStep)); });
    window.addEventListener('resize', () => move(0));
  })();
</script>
{% schema %}
{"name":"Customer review","settings":[{"type":"text","id":"aria_label","label":"Accessibility label","default":"Customer Review"},{"type":"text","id":"heading","label":"Heading","default":"Customer Review"}],"blocks":[{"type":"review","name":"Review image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":8,"presets":[{"name":"Customer review","blocks":[{"type":"review"},{"type":"review"},{"type":"review"},{"type":"review"},{"type":"review"},{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}


