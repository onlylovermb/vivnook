{{ 'section-vivnook-scrub-finale-banner.css' | asset_url | stylesheet_tag }}
<section class="vivnook-finale-banner" aria-label="{{ section.settings.aria_label | escape }}" style="--finale-left-heading-size:{{ section.settings.left_heading_size }}px;--finale-left-heading-size-mobile:{{ section.settings.left_heading_size_mobile }}px;--finale-left-heading-weight:{{ section.settings.left_heading_weight }};--finale-left-heading-weight-mobile:{{ section.settings.left_heading_weight_mobile }};--finale-left-subheading-size:{{ section.settings.left_subheading_size }}px;--finale-left-subheading-size-mobile:{{ section.settings.left_subheading_size_mobile }}px;--finale-left-subheading-weight:{{ section.settings.left_subheading_weight }};--finale-left-subheading-weight-mobile:{{ section.settings.left_subheading_weight_mobile }};--finale-left-body-size:{{ section.settings.left_body_size }}px;--finale-left-body-size-mobile:{{ section.settings.left_body_size_mobile }}px;--finale-left-body-weight:{{ section.settings.left_body_weight }};--finale-left-body-weight-mobile:{{ section.settings.left_body_weight_mobile }};--finale-left-y:{{ section.settings.left_vertical_position }}px;--finale-left-y-mobile:{{ section.settings.left_vertical_position_mobile }}px;--finale-right-heading-size:{{ section.settings.right_heading_size }}px;--finale-right-heading-size-mobile:{{ section.settings.right_heading_size_mobile }}px;--finale-right-heading-weight:{{ section.settings.right_heading_weight }};--finale-right-heading-weight-mobile:{{ section.settings.right_heading_weight_mobile }};--finale-right-subheading-size:{{ section.settings.right_subheading_size }}px;--finale-right-subheading-size-mobile:{{ section.settings.right_subheading_size_mobile }}px;--finale-right-subheading-weight:{{ section.settings.right_subheading_weight }};--finale-right-subheading-weight-mobile:{{ section.settings.right_subheading_weight_mobile }};--finale-right-body-size:{{ section.settings.right_body_size }}px;--finale-right-body-size-mobile:{{ section.settings.right_body_size_mobile }}px;--finale-right-body-weight:{{ section.settings.right_body_weight }};--finale-right-body-weight-mobile:{{ section.settings.right_body_weight_mobile }};--finale-right-y:{{ section.settings.right_vertical_position }}px;--finale-right-y-mobile:{{ section.settings.right_vertical_position_mobile }}px;">
  <div class="vivnook-finale-banner__copy">
    {% if section.settings.left_image != blank %}{{ section.settings.left_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'vivnook-finale-banner__gift' }}{% endif %}
    <div class="vivnook-finale-banner__copy-text"><h2>{{ section.settings.left_heading | escape }}</h2>
      <div class="vivnook-finale-banner__details vivnook-finale-banner__details--separate">
        {% for index in (1..3) %}{% assign subtitle_key = 'left_detail_' | append: index | append: '_subtitle' %}{% assign body_key = 'left_detail_' | append: index | append: '_body' %}{% assign subtitle = section.settings[subtitle_key] %}{% assign body = section.settings[body_key] %}{% if subtitle != blank or body != blank %}<div class="vivnook-finale-banner__detail">{% if subtitle != blank %}<h4>{{ subtitle | escape }}</h4>{% endif %}{% if body != blank %}<div class="vivnook-finale-banner__detail-body">{{ body }}</div>{% endif %}</div>{% endif %}{% endfor %}
      </div>
    </div>
  </div>
  <div class="vivnook-finale-banner__visual">{% if section.settings.right_image != blank %}{{ section.settings.right_image | image_url: width: 1800 | image_tag: loading: 'lazy' }}{% endif %}<div class="vivnook-finale-banner__overlay"><h2>{{ section.settings.right_heading | escape }}</h2><h3>{{ section.settings.right_subheading | escape }}</h3><div>{{ section.settings.right_body }}</div></div></div>
</section>
