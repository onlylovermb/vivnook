{{ 'section-vivnook-home-fabric.css' | asset_url | stylesheet_tag }}
<section class="vivnook-scrubs-feature scrubs-heading-weight-{{ section.settings.heading_weight | default: 400 }} scrubs-body-weight-{{ section.settings.body_weight | default: 400 }} scrubs-fabric-weight-{{ section.settings.fabric_text_weight | default: 400 }}" aria-label="{{ section.settings.aria_label | escape }}" style="--scrubs-desktop-top-height:{{ section.settings.desktop_top_height | default: 500 }}px;--scrubs-desktop-bottom-height:{{ section.settings.desktop_bottom_height | default: 500 }}px;--scrubs-mobile-left-height:{{ section.settings.mobile_left_height | default: 500 }}px;--scrubs-mobile-top-height:{{ section.settings.mobile_top_height | default: 500 }}px;--scrubs-mobile-bottom-height:{{ section.settings.mobile_bottom_height | default: 300 }}px;--scrubs-heading-desktop:{{ section.settings.heading_desktop_scale | default: 100 | divided_by: 100.0 }};--scrubs-heading-mobile:{{ section.settings.heading_mobile_scale | default: 90 | divided_by: 100.0 }};--scrubs-body-desktop:{{ section.settings.body_desktop_scale | default: 100 | divided_by: 100.0 }};--scrubs-body-mobile:{{ section.settings.body_mobile_scale | default: 90 | divided_by: 100.0 }};--scrubs-button-desktop:{{ section.settings.button_desktop_scale | default: 100 | divided_by: 100.0 }};--scrubs-button-mobile:{{ section.settings.button_mobile_scale | default: 90 | divided_by: 100.0 }};--scrubs-button-desktop-width:{{ section.settings.button_desktop_width | default: 250 }}px;--scrubs-button-desktop-height:{{ section.settings.button_desktop_height | default: 48 }}px;--scrubs-button-mobile-width:{{ section.settings.button_mobile_width | default: 250 }}px;--scrubs-button-mobile-height:{{ section.settings.button_mobile_height | default: 48 }}px;--scrubs-fabric-desktop:{{ section.settings.fabric_text_desktop_scale | default: 100 | divided_by: 100.0 }};--scrubs-fabric-mobile:{{ section.settings.fabric_text_mobile_scale | default: 90 | divided_by: 100.0 }};">
  <div class="vivnook-scrubs-feature__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 1000, 1400, 1800', sizes: '50vw' }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div>
  <div class="vivnook-scrubs-feature__side"><div class="vivnook-scrubs-feature__content"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.body != blank %}<div class="vivnook-scrubs-feature__body">{{ section.settings.body }}</div>{% endif %}{% if section.settings.button_label != blank %}<a href="{{ section.settings.button_link | default: '/collections/scrub-tops' }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div><div class="vivnook-scrubs-feature__image vivnook-scrubs-feature__image--secondary">{% if section.settings.image_2 != blank %}{% render 'vivnook-fabric-picture', image: section.settings.image_2, width: 1800, widths: '600, 1000, 1400, 1800' %}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<div class="vivnook-scrubs-feature__fabric-copy"><span>01&nbsp; ULTRA 4-WAY STRETCH</span><span>02&nbsp; ANTI-WRINKLE &amp; DRAPE</span><span>03&nbsp; FADE-RESISTANT TECH</span><span>04&nbsp; LINT-REPELLENT FINISH</span></div></div></div>
</section>
{% schema %}
{"name":"Scrubs feature","settings":[{"type":"text","id":"aria_label","label":"Accessibility label","default":"EverTrue Fabric Laboratory"},{"type":"image_picker","id":"image","label":"Image"},{"type":"image_picker","id":"image_2","label":"Secondary image"},{"type":"text","id":"heading","label":"Heading","default":"EverTrue Fabric Laboratory"},{"type":"richtext","id":"body","label":"Body","default":"<p>Introducing EverTrue textile technology.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore The Scrubs"},{"type":"url","id":"button_link","label":"Button link"},{"type":"header","content":"Typography and sizing"},{"type":"range","id":"desktop_top_height","label":"Desktop right top height","min":250,"max":1000,"step":10,"unit":"px","default":500},{"type":"range","id":"desktop_bottom_height","label":"Desktop right bottom height","min":250,"max":1000,"step":10,"unit":"px","default":500},{"type":"range","id":"mobile_left_height","label":"Mobile left image height","min":250,"max":1000,"step":10,"unit":"px","default":500},{"type":"range","id":"mobile_top_height","label":"Mobile right top height","min":300,"max":1000,"step":10,"unit":"px","default":500},{"type":"range","id":"mobile_bottom_height","label":"Mobile right bottom height","min":200,"max":800,"step":10,"unit":"px","default":300},{"type":"range","id":"heading_desktop_scale","label":"Heading desktop scale","min":70,"max":140,"step":5,"unit":"%","default":100},{"type":"range","id":"heading_mobile_scale","label":"Heading mobile scale","min":70,"max":130,"step":5,"unit":"%","default":90},{"type":"range","id":"body_desktop_scale","label":"Body desktop scale","min":70,"max":140,"step":5,"unit":"%","default":100},{"type":"range","id":"body_mobile_scale","label":"Body mobile scale","min":70,"max":130,"step":5,"unit":"%","default":90},{"type":"range","id":"button_desktop_scale","label":"Button desktop scale","min":70,"max":140,"step":5,"unit":"%","default":100},{"type":"range","id":"button_mobile_scale","label":"Button mobile scale","min":70,"max":130,"step":5,"unit":"%","default":90},{"type":"range","id":"button_desktop_width","label":"Button desktop width","min":120,"max":500,"step":5,"unit":"px","default":250},{"type":"range","id":"button_desktop_height","label":"Button desktop height","min":36,"max":100,"step":2,"unit":"px","default":48},{"type":"range","id":"button_mobile_width","label":"Button mobile width","min":120,"max":500,"step":5,"unit":"px","default":250},{"type":"range","id":"button_mobile_height","label":"Button mobile height","min":36,"max":100,"step":2,"unit":"px","default":48},{"type":"select","id":"heading_weight","label":"Heading weight","options":[{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"700","label":"Bold"}],"default":"400"},{"type":"select","id":"body_weight","label":"Body and button weight","options":[{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"700","label":"Bold"}],"default":"400"},{"type":"range","id":"fabric_text_desktop_scale","label":"Fabric text desktop scale","min":70,"max":140,"step":5,"unit":"%","default":100},{"type":"range","id":"fabric_text_mobile_scale","label":"Fabric text mobile scale","min":70,"max":130,"step":5,"unit":"%","default":90},{"type":"select","id":"fabric_text_weight","label":"Fabric text weight","options":[{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"700","label":"Bold"}],"default":"400"}],"presets":[{"name":"Scrubs feature"}]}
{% endschema %}
