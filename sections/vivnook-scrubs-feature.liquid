{{ 'section-vivnook-scrubs-feature.css' | asset_url | stylesheet_tag }}
<section class="vivnook-scrubs-feature" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="vivnook-scrubs-feature__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 1000, 1400, 1800', sizes: '50vw' }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div>
  <div class="vivnook-scrubs-feature__side"><div class="vivnook-scrubs-feature__content"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.body != blank %}<div class="vivnook-scrubs-feature__body">{{ section.settings.body }}</div>{% endif %}{% if section.settings.button_label != blank %}<a href="{{ section.settings.button_link | default: '/collections/scrub-tops' }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div><div class="vivnook-scrubs-feature__image vivnook-scrubs-feature__image--secondary">{% if section.settings.image_2 != blank %}{{ section.settings.image_2 | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 1000, 1400, 1800', sizes: '50vw' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<div class="vivnook-scrubs-feature__fabric-copy"><span>01&nbsp; ULTRA 4-WAY STRETCH</span><span>02&nbsp; ANTI-WRINKLE &amp; DRAPE</span><span>03&nbsp; FADE-RESISTANT TECH</span><span>04&nbsp; LINT-REPELLENT FINISH</span></div></div></div>
</section>
{% schema %}
{"name":"Scrubs feature","settings":[{"type":"text","id":"aria_label","label":"Accessibility label","default":"EverTrue Fabric Laboratory"},{"type":"image_picker","id":"image","label":"Image"},{"type":"image_picker","id":"image_2","label":"Secondary image"},{"type":"text","id":"heading","label":"Heading","default":"EverTrue™ Fabric Laboratory"},{"type":"richtext","id":"body","label":"Body","default":"<p>Introducing EverTrue™ textile technology. A curation of high-performance, premium medical scrubs meticulously custom-engineered to breathe, stretch, and endure through the most high-intensity clinical shifts.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore The Scrubs"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Scrubs feature"}]}
{% endschema %}
