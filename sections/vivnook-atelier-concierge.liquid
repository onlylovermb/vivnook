{{ 'section-vivnook-atelier-concierge.css' | asset_url | stylesheet_tag }}
{% style %}
@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&display=swap');
.vivnook-atelier-concierge,.vivnook-atelier-concierge *{font-family:'Open Sans',Arial,sans-serif!important}
{% endstyle %}
<section class="vivnook-atelier-concierge" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="vivnook-atelier-concierge__grid">
    {% for block in section.blocks %}
      <article class="vivnook-atelier-concierge__item" {{ block.shopify_attributes }}>
        {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.image != blank %}<a class="vivnook-atelier-concierge__image" href="{{ block.settings.link | default: '#' }}">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 750px) 22vw, 80vw' }}</a>{% else %}<div class="vivnook-atelier-concierge__image">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
        <div class="vivnook-atelier-concierge__body">
          {% if block.settings.heading == 'The Atelier' %}
            <p>Bespoke Tailoring &amp; Signature Embroidery</p>
            <p>Accommodating the unique movements of every individual. We offer personalized inseam alterations and precision-crafted signature embroidery to sculpt a clinical wardrobe uniquely yours.</p>
          {% elsif block.settings.heading == 'The Concierge' %}
            <p>Complimentary Global Distribution &amp; Flawless Returns</p>
            <p>Enjoy complimentary priority shipping worldwide, with dedicated transit delivering your wardrobe within 6–10 business days. Seamless, stress-free returns are honored globally, excluding custom orders and bespoke alterations.</p>
          {% elsif block.settings.body != blank %}
            {{ block.settings.body }}
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Atelier concierge","settings":[{"type":"text","id":"aria_label","label":"Accessibility label","default":"Atelier and Concierge services"}],"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","id":"heading","label":"Heading","default":"The Atelier"},{"type":"image_picker","id":"image","label":"Image"},{"type":"richtext","id":"body","label":"Description","default":"<p>Add your service description here.</p>"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":2,"presets":[{"name":"Atelier concierge","blocks":[{"type":"service","settings":{"heading":"The Atelier"}},{"type":"service","settings":{"heading":"The Concierge"}}]}]}
{% endschema %}
