{{ 'section-vivnook-home-mosaic.css' | asset_url | stylesheet_tag }}
<section class="vivnook-home-mosaic">
  <div class="vivnook-home-mosaic__left">{% if section.settings.left_image != blank %}{{ section.settings.left_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '800,1200,1600,1800', sizes: '50vw' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}</div>
  <div class="vivnook-home-mosaic__top">{% if section.settings.top_image != blank %}{{ section.settings.top_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', sizes: '50vw' }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div>
  <div class="vivnook-home-mosaic__bottom">{% if section.settings.bottom_image != blank %}{{ section.settings.bottom_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', sizes: '50vw' }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div>
</section>
{% schema %}{"name":"Three image mosaic","settings":[{"type":"image_picker","id":"left_image","label":"Left image"},{"type":"image_picker","id":"top_image","label":"Right top image"},{"type":"image_picker","id":"bottom_image","label":"Right bottom image"}],"presets":[{"name":"Three image mosaic"}]}{% endschema %}
