{{ 'section-vivnook-scrub-fabric-laboratory.css' | asset_url | stylesheet_tag }}
<section class="vivnook-fabric-lab" aria-label="{{ section.settings.aria_label | escape }}" style="--fabric-lab-video-height: {{ section.settings.video_height }}px; --fabric-lab-video-height-mobile: {{ section.settings.video_height_mobile }}px; --fabric-lab-intro-title-size: {{ section.settings.intro_title_size }}px; --fabric-lab-intro-title-size-mobile: {{ section.settings.intro_title_size_mobile }}px; --fabric-lab-intro-text-size: {{ section.settings.intro_text_size }}px; --fabric-lab-intro-text-size-mobile: {{ section.settings.intro_text_size_mobile }}px; --fabric-lab-feature-title-size: {{ section.settings.feature_title_size }}px; --fabric-lab-feature-title-size-mobile: {{ section.settings.feature_title_size_mobile }}px; --fabric-lab-feature-text-size: {{ section.settings.feature_text_size }}px; --fabric-lab-feature-text-size-mobile: {{ section.settings.feature_text_size_mobile }}px; --fabric-lab-intro-title-weight: {{ section.settings.intro_title_weight }}; --fabric-lab-intro-text-weight: {{ section.settings.intro_text_weight }}; --fabric-lab-feature-title-weight: {{ section.settings.feature_title_weight }}; --fabric-lab-feature-text-weight: {{ section.settings.feature_text_weight }};">
  <div class="vivnook-fabric-lab__left">
    <div class="vivnook-fabric-lab__intro"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape | newline_to_br }}</p></div>
    <div class="vivnook-fabric-lab__feature">{% if section.settings.feature_image != blank %}{{ section.settings.feature_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '50vw' }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}<div class="vivnook-fabric-lab__feature-copy">{% for block in section.blocks %}<div class="vivnook-fabric-lab__item" {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><p>{{ block.settings.text | escape | newline_to_br }}</p></div>{% endfor %}</div></div>
  </div>
  <div class="vivnook-fabric-lab__image">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1600x' }}
    {% elsif section.settings.video_url != blank %}
      <video src="{{ section.settings.video_url | escape }}" autoplay loop muted controls playsinline preload="metadata" aria-label="EverTrue fabric in motion"></video>
    {% elsif section.settings.video_required %}
      <video autoplay loop muted playsinline preload="metadata" aria-label="EverTrue fabric in motion">
        <source src="{{ 'fanny-work-system.mp4' | asset_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.right_image != blank %}
      {{ section.settings.right_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '700, 1000, 1400, 1800', sizes: '50vw' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "EverTrue fabric lab",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "EverTrue fabric laboratory"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Fabric Laboratory"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Introducing EverTrue™ textile technology. A luxury curation of high-performance healthcare textiles custom-engineered to breathe, stretch, and endure through the most high-intensity shifts. Where clinical utility meets an avant-garde silhouette."
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Left lower image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Right video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Right video MP4 URL"
    },
    {
      "type": "checkbox",
      "id": "video_required",
      "label": "Video only (no image fallback)",
      "default": false
    },
    { "type": "header", "content": "Layout and typography" },
    { "type": "range", "id": "video_height", "label": "Right video height (desktop)", "min": 400, "max": 1400, "step": 10, "unit": "px", "default": 960 },
    { "type": "range", "id": "video_height_mobile", "label": "Right video height (mobile)", "min": 300, "max": 1000, "step": 10, "unit": "px", "default": 520 },
    { "type": "header", "content": "Top left: heading" },
    { "type": "range", "id": "intro_title_size", "label": "Desktop size", "min": 12, "max": 72, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "intro_title_size_mobile", "label": "Mobile size", "min": 12, "max": 60, "step": 1, "unit": "px", "default": 26 },
    { "type": "select", "id": "intro_title_weight", "label": "Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "header", "content": "Top left: body" },
    { "type": "range", "id": "intro_text_size", "label": "Desktop size", "min": 10, "max": 36, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "intro_text_size_mobile", "label": "Mobile size", "min": 10, "max": 30, "step": 1, "unit": "px", "default": 15 },
    { "type": "select", "id": "intro_text_weight", "label": "Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "header", "content": "Bottom left: subtitle" },
    { "type": "range", "id": "feature_title_size", "label": "Desktop size", "min": 10, "max": 36, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "feature_title_size_mobile", "label": "Mobile size", "min": 10, "max": 30, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "feature_title_weight", "label": "Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "header", "content": "Bottom left: body" },
    { "type": "range", "id": "feature_text_size", "label": "Desktop size", "min": 10, "max": 36, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "feature_text_size_mobile", "label": "Mobile size", "min": 10, "max": 30, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "feature_text_weight", "label": "Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }], "default": "400" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "01 / Ultra 4-Way Stretch Apparel"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Fluid, Adaptive Movement That Retains Its Structural Silhouette All Day Long."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "EverTrue fabric lab",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
