{{ 'section-vivnook-service-grid.css' | asset_url | stylesheet_tag }}
<section class="vivnook-service-grid" aria-label="{{ section.settings.aria_label | escape }}">
  {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
  <div class="vivnook-service-grid__items">
    {% for block in section.blocks %}
      <article class="vivnook-service-grid__item" {{ block.shopify_attributes }}>
        <div class="vivnook-service-grid__icon">
          {% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 400 | image_tag: loading: 'lazy', widths: '120, 240, 400', sizes: '160px' }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
        </div>
        {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape | newline_to_br }}</h3>{% endif %}
        {% if block.settings.link_label != blank %}<a href="{{ block.settings.link | default: '#' }}">– {{ block.settings.link_label | escape }} –</a>{% endif %}
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"Service grid",
  "settings":[{"type":"text","id":"aria_label","label":"Accessibility label","default":"At your service"},{"type":"text","id":"heading","label":"Heading","default":"At your service"}],
  "blocks":[{"type":"service","name":"Service","settings":[{"type":"image_picker","id":"icon","label":"Icon"},{"type":"textarea","id":"title","label":"Title"},{"type":"text","id":"link_label","label":"Link label","default":"Discover More"},{"type":"url","id":"link","label":"Policy link"}]}],
  "max_blocks":4,
  "presets":[{"name":"Service grid","blocks":[{"type":"service","settings":{"title":"Free Shipping"}},{"type":"service","settings":{"title":"Free Returns and Exchange"}},{"type":"service","settings":{"title":"Book a Private Appointment in Store"}},{"type":"service","settings":{"title":"Pick Up in Store"}}]}]
}
{% endschema %}
