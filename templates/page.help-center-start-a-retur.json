nt-size:16px}}\n</style>\n\n<style>\n  .vn-article__contact-row{display:block;margin-top:16px}\n  .vn-article__contact{margin-top:0}\n  .vn-article__feedback{position:relative}\n  .vn-article__content .vn-article__response{position:static;font-size:13px;line-height:1.4;margin:6px 0 0;color:#777}\n</style>\n\n<section class=\"vn-article\"><div class=\"vn-article__wrap\">\n  <nav class=\"vn-article__crumbs\">\n    <a href=\"/pages/help-center\">Help Center Home</a> /\n    <a href=\"/pages/shipping\">Shipping</a> /\n    <a href=\"/pages/help-center-shipping-faq\">Shipping FAQ</a> / Article\n  </nav>\n\n  <div class=\"vn-article__layout\">\n    <aside class=\"vn-article__side\">\n      <h2>Articles in this section</h2>\n    <a href=\"/pages/help-center-return-policy\">What is your return policy?</a>\n    <a class=\"is-active\" href=\"/pages/help-center-start-a-return\">How do I start a return?</a>\n    <a href=\"/pages/help-center-exchanges\">Can I exchange an item?</a>\n    <a href=\"/pages/help-center-damaged-wrong-item\">What if my item is damaged or incorrect?</a>\n    <a href=\"/pages/help-center-refund-timing\">When will I receive my refund?</a>\n    </aside>\n\n    <article class=\"vn-article__content\">\n      <h1>How do I start a return?</h1>\n      <p class=\"vn-article__updated\">Updated October 2026</p>\n\n      <div class=\"vn-article__slot\">\n        <p>To start a return or exchange, please contact our concierge team at support@vivnook.com or submit the Return Request Form on our Contact Us page.</p>\n\n        <h2>Step 1: Submit your request</h2>\n        <p>Include your order number, the specific item or items you want to return or exchange, and the reason for your request.</p>\n\n        <h2>Step 2: Concierge consultation</h2>\n        <p>A customer service representative will contact you by email within 24–48 hours to verify the request and guide you through authorization.</p>\n\n        <h2>Step 3: Receive your pre-paid label</h2>\n        <p>Once your request is authorized, we will email you a downloadable PDF pre-paid shipping label and a return packing slip.</p>\n\n        <h2>Step 4: Drop off and track</h2>\n        <p>Pack the approved item securely, attach the label and drop it off at a designated postal facility or courier drop box. You will receive tracking updates once the package is scanned.</p>\n\n        <p>Please do not send any item back before receiving return authorization.</p>\n      </div>\n\n      <div class=\"vn-article__feedback\">\n        <p>Was this article helpful?</p>\n        <button type=\"button\" data-vn-feedback=\"yes\">Yes</button>\n        <button type=\"button\" data-vn-feedback=\"no\">No</button>\n        <p class=\"vn-article__response\" data-vn-response aria-live=\"polite\"></p>\n        <div class=\"vn-article__contact-row\"><span class=\"vn-article__contact-text\">Have more questions?</span> <a class=\"vn-article__contact\" href=\"https://azbi0u-6f.myshopify.com/pages/contact\">Contact Us</a></div>\n      </div>\n    </article>\n  </div>\n</div></section>\n\n<script>\n  (function () {\n    var buttons = document.querySelectorAll('[data-vn-feedback]');\n    var response = document.querySelector('[data-vn-response]');\n    if (!buttons.length || !response) return;\n    buttons.forEach(function (button) {\n      button.addEventListener('click', function () {\n        buttons.forEach(function (item) { item.classList.remove('is-selected'); });\n        button.classList.add('is-selected');\n        response.textContent = button.getAttribute('data-vn-feedback') === 'yes'\n          ? 'Thank you — we’re glad this helped.'\n          : 'Thank you for letting us know. We’ll keep improving our help content.';\n        response.classList.add('is-visible');\n      });\n    });\n  })();\n</script>",
