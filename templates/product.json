        "column_pLpad8": {
          "type": "column",
          "settings": {
            "image_width": "medium",
            "title": "Keep You Organised",
            "heading_size": "h4",
            "heading_tag": "h3",
            "text": "<p>We replaced bulky pockets with a belt bag that holds more than any set of scrubs—without the bulk. Magnetic buckle, multiple compartments, no digging, no dropping.</p>",
            "text_size": "text-base"
          }
        },
        "column_nVmYnC": {
          "type": "column",
          "settings": {
